                                    <span class="job-tag"><i class="fa fa-paint-brush"></i> Sketch</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap">
                                    <div>
                                        <span class="salary-text"><i class="fa fa-usd"></i> $90k - $130k</span>
                                        <span class="text-muted mx-2">•</span>
                                        <span><i class="fa fa-briefcase"></i> Full-time</span>
                                        <span class="text-muted mx-2">•</span>
                                        <span><i class="fa fa-calendar"></i> Posted 3 days ago</span>
                                    </div>
                                    <a href="/apply?job=ui-ux-designer" class="btn btn-apply"><i class="fa fa-send"></i>
                                        Apply Now</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Job Card 3 -->
                <div class="card job-card">
                    <div class="card-body p-4">
                        <div class="row">
                            <div class="col-auto">
                                <div class="company-logo">
                                    <i class="fa fa-amazon"></i>
                                </div>
                            </div>
                            <div class="col">
                                <div class="d-flex justify-content-between align-items-start flex-wrap">
                                    <div>
                                        <h3 class="job-title">DevOps Engineer</h3>
                                        <p class="company-name"><i class="fa fa-building"></i> Amazon Web Services <span
                                                class="text-muted mx-2">•</span> <i class="fa fa-map-marker"></i>
                                            Seattle, WA</p>
                                    </div>
                                    <span class="job-badge badge-onsite"><i class="fa fa-building-o"></i> On-site</span>
                                </div>
                                <p class="mt-2">Seeking a DevOps Engineer to manage and scale cloud infrastructure,
                                    implement CI/CD pipelines, and ensure system reliability.</p>
                                <div class="mb-2">
                                    <span class="job-tag"><i class="fa fa-docker"></i> Docker</span>
                                    <span class="job-tag"><i class="fa fa-kubernetes"></i> Kubernetes</span>
                                    <span class="job-tag"><i class="fa fa-jenkins"></i> Jenkins</span>
                                    <span class="job-tag"><i class="fa fa-aws"></i> AWS</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap">
                                    <div>
                                        <span class="salary-text"><i class="fa fa-usd"></i> $130k - $180k</span>
                                        <span class="text-muted mx-2">•</span>
                                        <span><i class="fa fa-briefcase"></i> Full-time</span>
                                        <span class="text-muted mx-2">•</span>
                                        <span><i class="fa fa-calendar"></i> Posted 1 week ago</span>
                                    </div>
                                    <a href="/apply?job=devops-engineer" class="btn btn-apply"><i
                                            class="fa fa-send"></i> Apply Now</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Job Card 4 -->
                <div class="card job-card">
                    <div class="card-body p-4">
                        <div class="row">
                            <div class="col-auto">
                                <div class="company-logo">
                                    <i class="fa fa-meta"></i>
                                </div>
                            </div>
