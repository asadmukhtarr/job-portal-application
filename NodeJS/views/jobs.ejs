                                        <span class="text-muted mx-2">•</span>
                                        <span><i class="fa fa-calendar"></i> Posted 4 days ago</span>
                                    </div>
                                    <a href="/apply?job=data-engineer" class="btn btn-apply"><i class="fa fa-send"></i>
                                        Apply Now</a>
                                </div>
                            </div>
                        </div>
