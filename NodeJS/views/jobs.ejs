                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Job Card 2 -->
                <div class="card job-card">
                    <div class="card-body p-4">
                        <div class="row">
                            <div class="col-auto">
                                <div class="company-logo">
                                    <i class="fa fa-microsoft"></i>
